OPENAI_API_KEY=



# Model from .env only (no hardcoded default in code)

OPENAI_COMPUTER_USE_MODEL=gpt-6-luna



# Job apply config: job_url + resume_path

APPLY_CONFIG=apply.config.json

# Optional one-off overrides:

# JOB_URL=https://...

# RESUME_PATH=resumes/resume.pdf

# Open the apply resume PDF in another window (OS default viewer) so you can
# verify the correct file. Default off. Works for local apply and worker runs.

# OPEN_RESUME_PREVIEW=1

# Contact (prefer .env over committing to apply.config.json):

# APPLICANT_EMAIL=you@example.com

# APPLICANT_PHONE=+1...

# Employer-site account signup (non-major companies). Password stays in .env:

# APPLY_ACCOUNT_EMAIL=you@example.com

# APPLY_ACCOUNT_PASSWORD=



BROWSER_PROFILE=.camoufox-profile

# Own Camoufox browser binary (avoids conflict with another Camoufox on this PC)

CAMOUFOX_INSTALL_DIR=.cache/camoufox-install

# Landed worker — defaults: API http://localhost:8180, token from ../landed/.env

# LANDED_API_URL=http://localhost:8180

# LANDED_WORKER_TOKEN=

# LANDED_ENV_FILE=C:/Users/jared/programming/landed/.env

# WORKER_CONFIG=worker.config.json

# Optional start URL for: python -m computer_use.apply --login

# LOGIN_START_URL=https://accounts.google.com



# NopeCHA Firefox addon (Camoufox) — Turnstile / reCAPTCHA / Cloudflare. On by default.

# API key optional (free tier is keyed by IP). Paid: https://nopecha.com

NOPECHA_ENABLED=1

# NOPECHA_API_KEY=

# NOPECHA_SOLVE_TIMEOUT_MS=90000

# Also accepts LANDED_NOPECHA_API_KEY if you already set that for landed.



# NoneCap — hCaptcha token API (required for hCaptcha; Chrome extension won't load in Camoufox)

# Mint a key: https://dashboard.nonecap.com  (1,300 free credits on signup)

NONECAP_ENABLED=1

# NONECAP_KEY=nc_live_...

# NONECAP_WAIT_SECONDS=90



SUBMIT_APPLICATION=0

COSTS_PATH=costs.json

MAX_TURNS=80

# Per-turn AI think/say/computer/tool logs in the terminal (colored). Default on.
AI_TURN_LOGS_ENABLED=1

# Tips + hard multi-turn runs are appended here (also shown in the apply prompt).
# APPLY_LEARNINGS_PATH=apply_learnings.json
# Record a hard_run when a job uses at least this many AI turns (default 12).
# LEARNING_TURN_THRESHOLD=12

# Disable apply features (tools + their prompts) by name, comma-separated.
# Names: form_knowledge, learnings, account_signup, verification_code
# APPLY_DISABLE_FEATURES=learnings


