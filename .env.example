OPENAI_API_KEY=

# Model used for Agents API computer-use sessions
OPENAI_COMPUTER_USE_MODEL=gpt-6-astra

# Indeed account used when the hosted browser requests sign-in
INDEED_EMAIL=
INDEED_PASSWORD=

# Comma-separated origins to auto-approve (no interactive prompt)
AUTO_APPROVE_ORIGINS=https://www.indeed.com,https://indeed.com,https://secure.indeed.com,https://account.indeed.com,https://auth.indeed.com

# Job search used by the Indeed Quick Apply flow
INDEED_QUERY=software engineer
INDEED_LOCATION=Remote

# Set to 1 to click the final Quick Apply / Submit button
SUBMIT_APPLICATION=0

# Set to 1 to keep the Agents API session after a successful run (for debugging)
KEEP_SESSION=0
